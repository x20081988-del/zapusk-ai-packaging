# ──────────────────────────────────────────────────────────────
# Zapusk AI Packaging — environment template
# Copy this file to .env (in /server) and fill in the values.
# Without API keys the app still runs — AI layer falls back to deterministic mocks.
# ──────────────────────────────────────────────────────────────

# ── Server runtime ────────────────────────────────────────────
# Local dev uses 4000; in production the host (Render / Railway / Fly) injects PORT.
PORT=4000
NODE_ENV=development

# SQLite by default. For Postgres in production, change provider in
# prisma/schema.prisma and set DATABASE_URL to your connection string.
DATABASE_URL="file:./dev.db"

# Where uploads live. On a single-service prod host, point this at a persistent
# disk path, e.g. "/data/uploads".
UPLOADS_DIR=./uploads

# Where the compiled SPA lives. Default works when server/dist sits next to
# web/dist (both produced by `npm run build`). Override for custom layouts.
WEB_DIST_DIR=../../web/dist

# ── Cross-origin policy ───────────────────────────────────────
# In single-service deploys (one URL for both SPA and API) leave as the SPA
# origin or use "*" — requests will be same-origin and CORS never fires.
# In split deploys (SPA on Vercel, API on Render) set this to the SPA's URL.
CORS_ORIGIN=http://localhost:5173

# ── Public demo lockdown ──────────────────────────────────────
# Set DEMO_MODE=true on a public URL to block destructive ops (DELETE on /api/*,
# template create/edit). Visitors can still create projects, generate, review.
DEMO_MODE=false

# ── Auth (MVP — single-user dev mode) ─────────────────────────
DEV_USER_EMAIL=founder@zapusk.tech
DEV_USER_NAME=Zapusk Founder

# ── AI providers (optional — app uses mock layer if missing) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
OPENAI_API_KEY=
OPENAI_MODEL_MAIN=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_REALTIME=gpt-4o-realtime-preview
AI_LOG_USAGE=true

# Preferred provider: anthropic | openai | mock
AI_PROVIDER=mock

# ── Web build-time ────────────────────────────────────────────
# In single-service prod, leave empty so the SPA hits same-origin /api/*.
# In split deploys, set to your API URL: VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
