# ──────────────────────────────────────────────────────────────
# Zapusk AI Packaging — environment template
# Copy this file to .env (in /server) and fill in the values.
# Without API keys the app still runs — AI layer falls back to deterministic mocks.
# ──────────────────────────────────────────────────────────────

# ── Server runtime ────────────────────────────────────────────
# Local dev uses 4000; in production the host (Render / Railway / Fly) injects PORT.
PORT=4000
NODE_ENV=development

# SQLite by default. For Postgres in production, change provider in
# prisma/schema.prisma and set DATABASE_URL to your connection string.
DATABASE_URL="file:./dev.db"

# Where uploads live. On a single-service prod host, point this at a persistent
# disk path, e.g. "/data/uploads".
UPLOADS_DIR=./uploads

# Where the compiled SPA lives. Default works when server/dist sits next to
# web/dist (both produced by `npm run build`). Override for custom layouts.
WEB_DIST_DIR=../../web/dist

# ── Cross-origin policy ───────────────────────────────────────
# In single-service deploys (one URL for both SPA and API) leave as the SPA
# origin or use "*" — requests will be same-origin and CORS never fires.
# In split deploys (SPA on Vercel, API on Render) set this to the SPA's URL.
CORS_ORIGIN=http://localhost:5173

# ── Public demo lockdown ──────────────────────────────────────
# Set DEMO_MODE=true on a public URL to block destructive ops (DELETE on /api/*,
# template create/edit). Visitors can still create projects, generate, review.
DEMO_MODE=false

# ── Auth (MVP — single-user dev mode) ─────────────────────────
DEV_USER_EMAIL=founder@zapusk.tech
DEV_USER_NAME=Zapusk Founder

# ── JWT signing (Sprint 19) ───────────────────────────────────
# На production обязательно задать >=32 символов. Без него auth работает
# на dev fallback (с warn в логах).
JWT_SECRET=

# ── Bootstrap accounts (Sprint 25) ────────────────────────────
# Платформа создаёт 5 типовых аккаунтов при старте через seed:
# grigory@zapusk.tech (SUPER_ADMIN), admin@zapusk.tech (ADMIN),
# manager@zapusk.tech (MANAGER), demo-founder@zapusk.tech (FOUNDER+demo),
# demo-investor@zapusk.tech (INVESTOR+demo).
#
# Пароли НЕ хардкодятся в репозиторий. Без env-переменной аккаунт
# создаётся disabled (без passwordHash) + warn в console.
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_MANAGER_PASSWORD=
BOOTSTRAP_DEMO_PASSWORD=

# Опциональные override email'ов (для white-label deployment'ов).
BOOTSTRAP_OWNER_EMAIL=grigory@zapusk.tech
BOOTSTRAP_ADMIN_EMAIL=admin@zapusk.tech
BOOTSTRAP_MANAGER_EMAIL=manager@zapusk.tech
BOOTSTRAP_DEMO_FOUNDER_EMAIL=demo-founder@zapusk.tech
BOOTSTRAP_DEMO_INVESTOR_EMAIL=demo-investor@zapusk.tech

# ── AI providers (optional — app uses mock layer if missing) ──
# Без любого из ключей соответствующий провайдер возвращает детерминированный
# mock, status='mock' и понятный errorCode. UX не блокируется ни в одном
# сценарии.

# OpenAI — sales-assistant + conversation-analysis + investor_summary / faq / sales_gpt.
OPENAI_API_KEY=
OPENAI_MODEL_MAIN=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_REALTIME=gpt-4o-realtime-preview

# Anthropic (Claude) — packaging pipeline: financial / calculator_spec.
# Sprint 17: MAIN / FAST split. ANTHROPIC_MODEL оставлен как back-compat alias.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_MAIN=claude-opus-4-1
ANTHROPIC_MODEL_FAST=claude-sonnet-4-5

# Deepgram — pre-recorded transcription для /conversation-analysis (audio upload).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# Lovable — landing / one-pager / web pitch deck. Sprint 17.
# Контракт API публично не задокументирован: client делает POST {base}/projects
# с {prompt, name, metadata} и ожидает {id, url, preview_url, status}.
LOVABLE_API_KEY=
LOVABLE_API_BASE_URL=https://api.lovable.dev

AI_LOG_USAGE=true

# Preferred provider для legacy aiClient (sales-assistant / conversation-analysis):
# anthropic | openai | mock. Packaging Pipeline (Sprint 15+) использует per-template
# provider из Templates.orchestration, независимо от AI_PROVIDER.
AI_PROVIDER=mock

# ── Web build-time ────────────────────────────────────────────
# In single-service prod, leave empty so the SPA hits same-origin /api/*.
# In split deploys, set to your API URL: VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
