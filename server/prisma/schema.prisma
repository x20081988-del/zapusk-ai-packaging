// Zapusk AI Packaging — data model
// Swap provider to "postgresql" for production; schema is compatible.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  // Sprint 19: real auth fields. passwordHash хранится как «scrypt:salt:hash»
  // (hex), nullable для back-compat (demo / passwordless seed users).
  passwordHash String?
  // Sprint 25 — нормальная ролевая система B2B investment OS.
  // SQLite не поддерживает Prisma enum, поэтому держим String с фиксированным
  // списком значений. Валидация — в backend zod-схемах и normalizeRole().
  // Значения: SUPER_ADMIN / ADMIN / MANAGER / FOUNDER / INVESTOR.
  // Миграция Sprint 25 переименовала старые: admin→ADMIN, client→FOUNDER,
  // manager→MANAGER, demo→FOUNDER, sales→MANAGER, viewer→FOUNDER.
  role      String   @default("FOUNDER")
  // Sprint 22: invite-only architecture.
  // Воронка: lead → demo → approved → awaiting_payment → active → (paused/archived).
  // По умолчанию — 'lead' (никаких прав до approval).
  workspaceStatus String @default("lead")
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  projects  Project[]
  invitesCreated InviteToken[] @relation("InviteCreatedBy")
}

// Sprint 22 — Invite-only architecture. Никаких public signup'ов:
// admin/sales создаёт invite token → отправляет ссылку человеку → человек
// открывает /signup?invite=<token> → создаёт аккаунт с target role +
// workspaceStatus из invite'а.
model InviteToken {
  id          String   @id @default(cuid())
  token       String   @unique  // random hex (32 bytes)
  email       String?  // если задан — invite строго под этот email; иначе универсальный
  role        String   @default("client")
  workspaceStatus String @default("active")  // что получит созданный user
  createdById String
  createdBy   User     @relation("InviteCreatedBy", fields: [createdById], references: [id])
  usedAt      DateTime?
  usedByUserId String?
  expiresAt   DateTime?  // null = бессрочный
  note        String?    // комментарий админа (имя проекта / источник)
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([usedAt])
}

// Sprint 37 P1 — Manager assignment (architecture note, NO migration yet).
//
// Сейчас MANAGER в коде проходит как admin-like (см. server/src/lib/ownership.ts:
// isAdminLike). На уровне списков это значит «любой менеджер видит всех клиентов».
// Это работает на MVP с 1-2 менеджерами, но плохо масштабируется.
//
// План Sprint 38+ (две альтернативы, выберем по факту):
//   A) Добавить Project.managerId String? @null + relation на User. Простая
//      one-to-one: один менеджер на проект. ManagerDashboard фильтрует по этому
//      полю; admin/super_admin видят всё.
//   B) Отдельная модель ProjectAssignment { projectId, managerId, role: 'lead'|'support', addedAt }
//      Many-to-many. Покрывает кейс «лид-менеджер + ассистент» и историю передач.
//
// Решение откладывается до момента, когда MANAGER станет >2 человек. До того
// admin-like read остаётся корректным MVP-поведением.

model Project {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])

  name             String
  inn              String?
  website          String?
  industry         String?
  legalStatus      String?   // ИП / ООО / ПАО / физлицо / иное
  stage            String?   // idea / mvp / early_revenue / scaling / growth
  raiseAmount      Float?    // сколько привлекает (в валюте проекта)
  currency         String    @default("RUB")
  minCheck         Float?    // минимальный чек инвестора
  equityOffered    Float?    // %
  raiseDeadline    DateTime?
  investorType     String?   // private / fund / strategic / grant

  status           String    @default("draft") // draft / packaging / ready
  // Sprint 21: формат привлечения инвестиций. Управляет, какие этапы покажутся
  // в «Пути привлечения инвестиций» (юридическая упаковка, маркетинговая,
  // размещение). null = пользователь ещё не выбрал.
  // Значения: 'shareholding' / 'llc_share' / 'convertible' / 'safe' / 'pre_ipo' / 'packaging_only'
  investmentTrack  String?
  // Sprint 24: глобальные демо-витрины. isDemo=true → проект виден только
  // пользователям с workspaceStatus='demo'. Сами по себе demo-проекты
  // хранятся под dev/admin user'ом, но обычные клиенты их не видят.
  isDemo           Boolean   @default(false)
  // Sprint 30: soft-delete. archivedAt=null = живой; archivedAt=Date = в корзине.
  // GET endpoints фильтруют archivedAt; admin может восстановить через
  // /api/admin/restore/project/:id.
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  files            UploadedFile[]
  brief            ProjectBrief?
  investorTerms    InvestorTerms?
  generatedPrompts GeneratedPrompt[]
  generatedDocs    GeneratedDocument[]
  referenceMats    ReferenceMaterial[]
  artefactReviews      ArtefactReview[]
  salesSessions        SalesSession[]
  conversationAnalyses ConversationAnalysis[]
  packagingJobs        PackagingJob[]
  briefVersions        ProjectBriefVersion[]
  knowledgeSources     KnowledgeSource[]
}

model UploadedFile {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  filename     String   // disk name (uuid + ext)
  originalName String
  mimeType     String
  size         Int
  category     String   // pitch / financial / description / image / logo / reference / other
  path         String   // local relative path under UPLOADS_DIR
  url          String?  // for external resources (google docs / notion / website)
  // Sprint 30: soft-delete — физический файл удаляется через 30 дней после archivedAt.
  archivedAt   DateTime?
  createdAt    DateTime @default(now())
}

// AI-extracted brief + "бизнес на салфетке"
model ProjectBrief {
  id              String   @id @default(cuid())
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version         Int      @default(1)

  businessSummary String?
  monetization    String?
  keyMetrics      String?  // JSON: { mrr, arr, gmv, users, churn, ... }
  investmentAsk   String?
  strengths       String?  // JSON array
  weaknesses      String?  // JSON array
  missingData     String?  // JSON array — flat list of questions for the AI Interview
  missingByCategory String?  // JSON: { financial: [...], market: [...], team: [...], deal: [...], unit_econ: [...], risks: [...] }
  interviewAnswers String?   // JSON array: [{ question, answer, category?, savedAt }] — captured via AI Interview
  napkin          String?  // JSON: structured "business on a napkin"
  rawAIResponse   String?  // full provider response for audit

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model InvestorTerms {
  id             String   @id @default(cuid())
  projectId      String   @unique
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  amount         Float?
  equityPercent  Float?
  valuation      Float?
  instrument     String?  // equity / SAFE / convertible_note / loan / grant
  useOfFunds     String?  // JSON breakdown
  exitStrategy   String?  // text
  expectedReturn String?  // ROI / IRR / multiplier
  payback        String?  // months / years

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Master library — editable templates per kind
model PromptTemplate {
  id          String   @id @default(cuid())
  key         String   @unique  // lovable_landing / lovable_pitch / cloud_design / financial / sales_gpt / faq / one_pager / pitch_structure / investment_summary / calculator_spec
  name        String
  category    String              // landing / pitch / financial / sales / faq / summary / spec
  description String?
  body        String              // template body with {{placeholders}}
  active      Boolean  @default(true)

  // Sprint 15: orchestration metadata. Templates are no longer just "prompt
  // bodies" — they declare WHICH AI provider runs them and WHAT output type
  // they produce. The Packaging Pipeline reads these to render badges,
  // dispatch jobs, and unify the AI orchestration story.
  provider    String?            // openai / claude / lovable / claude_design
  tool        String?            // gpt-4.1 / gpt-5.5 / claude-opus / lovable-web / claude-design-pdf
  model       String?            // optional concrete model id, e.g. gpt-4.1-2025-04
  outputType  String?            // faq / financial_model / landing / one_pager / pitch_deck / investor_summary / sales_assistant / calculator

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Sprint 15: every time a packaging artefact is requested we record the
// orchestration decision — which template/provider/tool produced it. This
// is the audit trail behind the «AI generated materials» history on the
// project cockpit.
model PackagingJob {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  templateId   String?
  templateKey  String              // PromptTemplate.key — мы зеркалим ключ, чтобы история не ломалась если шаблон удалили
  provider     String              // snapshot of template.provider at job time
  tool         String              // snapshot of template.tool
  model        String?
  outputType   String              // snapshot of template.outputType

  status       String   @default("succeeded") // queued / running / succeeded / failed / mock
  prompt       String              // resolved prompt body (the one we'd hand to the AI)
  resultPreview String?            // short summary of what was produced (for the cockpit history strip)

  // Pointers back to where the artefact actually lives (a GeneratedPrompt row
  // for prompt-style outputs, a GeneratedDocument for document-style outputs).
  // Nullable: a queued/failed job doesn't have an artefact yet.
  generatedPromptId   String?
  generatedDocumentId String?

  // Sprint 17: real-provider result fields. Заполняются после реального вызова
  // Claude / Lovable / Deepgram. Если ключ провайдера отсутствует — остаются
  // null, status переключается в 'mock', и UI рендерит детерминированный
  // fallback (resultPreview).
  providerJobId String?              // внешний id job'а у провайдера (Lovable вернёт свой id)
  previewUrl    String?              // ссылка на preview артефакта (Lovable preview URL)
  resultUrl     String?              // ссылка на сам артефакт (Lovable project URL / pdf download)
  resultJson    String?              // полный JSON ответа провайдера (для аудита)
  errorCode     String?              // короткий код ошибки если status='failed' (НЕ содержит ключей)
  errorMessage  String?              // одно-строчное сообщение пользователю
  completedAt   DateTime?            // когда провайдер вернул результат

  // Sprint 18: Managed Packaging Flow. Часть артефактов (landing, one_pager,
  // pitch deck) делаются менеджером вручную через внутренние инструменты —
  // фаундер не должен видеть Lovable / Claude Design / любые внешние tool names.
  //
  // status='awaiting_manager' → задача в очереди на ручную сборку.
  // managerComment — то, что менеджер хочет показать клиенту (можно пусто).
  // completedBy — email менеджера, который закрыл задачу (для аудита).
  managerComment String?
  completedBy    String?

  createdAt    DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, outputType])
  @@index([status])
}

model GeneratedPrompt {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind       String   // same vocabulary as PromptTemplate.key
  version    Int      @default(1)
  body       String   // resolved prompt — ready to copy
  feedback   String?  // optional feedback used to produce this version (regenerate-with-feedback)
  createdAt  DateTime @default(now())

  @@index([projectId, kind])
}

// Team review on a specific artefact (prompt / doc / brief). Multiple versions
// can be reviewed; latest score per artefact key feeds the Packaging Quality Score.
model ArtefactReview {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  artefactKind String  // 'prompt' / 'document' / 'brief'
  artefactKey  String  // PromptTemplate.key for prompts, document.kind for docs, 'brief' for the brief itself
  artefactId   String? // FK to specific version (GeneratedPrompt.id / GeneratedDocument.id)

  score        Int     // 1..5
  comment      String?
  approved     Boolean @default(false)   // "годится в работу"
  needsRework  Boolean @default(false)   // "нужно доработать"
  reviewer     String  // user email — MVP doesn't have roles yet

  // Sprint 30: soft-delete.
  archivedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, artefactKey])
}

model GeneratedDocument {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind      String   // investment_summary / one_pager / pitch_deck_structure / investor_faq / calculator_spec / napkin
  version   Int      @default(1)
  format    String   @default("markdown")   // markdown / json
  title     String
  body      String
  createdAt DateTime @default(now())

  @@index([projectId, kind])
}

model FinancialModelTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  sheets      String   // JSON structure of sheets / sections
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Investor Meeting Memory — каждая завершённая встреча превращается в карточку
// сделки: что важно помнить об инвесторе, возражения, следующий шаг, follow-up.
model SalesSession {
  id              String   @id @default(cuid())
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  leadId          String?   // necklink to AI Leads when meeting came from a qualified lead
  investorName    String?
  investorPhone   String?
  source          String   @default("sales_assistant")  // sales_assistant / manual / audio_upload / zoom

  startedAt       DateTime?
  endedAt         DateTime?
  transcript      String?   // full meeting transcript

  // AI structured summary
  summary           String?
  investorInterest  String?
  checkRange        String?
  objections        String?  // JSON string[]
  risks             String?  // JSON string[]
  materialsToSend   String?  // JSON string[]
  nextStep          String?
  followUpMessage   String?
  probabilityScore  Int?     // 0..100
  investorType      String?  // dividend / growth / preipo / strategic / unknown
  tone              String?  // hot / warm / cold
  managerNote       String?

  // AI provenance — never persist raw OpenAI text directly here in production.
  aiProvider      String?
  aiModel         String?
  fellBackToMock  Boolean   @default(false)

  // Sprint 30: soft-delete.
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([projectId])
  @@index([leadId])
}

// AI Conversation Intelligence — внешние записи разговоров (Zoom / Telegram /
// диктофон / Meet / WhatsApp / телефон) превращаются в structured AI-feedback:
// что улучшить, ошибки, что сработало, next best action, AI score.
// Это data moat — не CRM, а AI-слой поверх инвестиционных переговоров.
model ConversationAnalysis {
  id                    String   @id @default(cuid())
  projectId             String?
  project               Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  investorName          String?
  source                String   @default("audio_upload")
  originalFileName      String?
  fileSize              Int?
  mimeType              String?
  audioUrl              String?

  transcript            String?
  transcriptProvider    String?
  transcriptModel       String?
  transcriptDurationSec Float?

  analysis              String?  // JSON: full structured analysis

  aiScore               Int?     // 0..100 overall meeting score
  probabilityScore      Int?     // 0..100 deal probability
  sentiment             String?  // positive / neutral / negative
  spinStage             String?  // S / P / I / N

  aiProvider            String?
  aiModel               String?
  fellBackToMock        Boolean  @default(false)

  // Sprint 30: soft-delete.
  archivedAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([projectId])
  @@index([createdAt])
}

// Sprint 32 — версии брифа. ProjectBrief остаётся "current" (one-per-project),
// а каждое изменение (regenerate, interview answer, AI enrich) делает snapshot
// текущего состояния в ProjectBriefVersion ПЕРЕД update.
// Restore: копирует данные старой ProjectBriefVersion обратно в ProjectBrief.
// Append-only: версии никогда не редактируются и не удаляются.
model ProjectBriefVersion {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Снапшот всех полей ProjectBrief в момент перед update.
  version           Int
  businessSummary   String?
  monetization      String?
  keyMetrics        String?
  investmentAsk     String?
  strengths         String?
  weaknesses        String?
  missingData       String?
  missingByCategory String?
  interviewAnswers  String?
  napkin            String?
  rawAIResponse     String?

  // Откуда пришла версия — для аудита и UX.
  // 'ai_generate' | 'ai_regenerate' | 'ai_regenerate_feedback' | 'interview' | 'restore'
  source            String

  createdAt         DateTime @default(now())

  @@index([projectId, version])
  @@index([projectId, createdAt])
}

// Sprint 30 — audit trail для destructive operations и admin actions.
// Каждый delete / archive / restore / impersonate / invite revoke /
// workspaceStatus change пишет одну строку. Read-only для всех, кроме
// SUPER_ADMIN / ADMIN. Хранится бессрочно (важная forensic data).
model AuditEvent {
  id          String   @id @default(cuid())
  actorId     String?  // userId источника действия (null = system / seed)
  actorEmail  String?  // дублируем email для читаемости, даже если user удалён
  actorRole   String?  // снапшот роли в момент действия
  action      String   // 'project.archive' / 'file.archive' / 'review.archive' / ...
  targetType  String   // 'Project' / 'UploadedFile' / 'User' / 'InviteToken' / ...
  targetId    String?
  payload     String?  // JSON: до/после, дополнительный контекст
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
  @@index([action])
}

model ReferenceMaterial {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category  String   // landing / pitch / financial
  url       String?
  filePath  String?
  note      String?
  createdAt DateTime @default(now())
}

// Sprint 38 — Knowledge Base для AI-продаж инвесторам.
//
// AI-ассистент должен опираться не только на prompt, но и на накопленные
// успехи команды: разборы встреч, кейсы, скрипты, объекции, follow-up'ы,
// инвест-презентации. MVP: SQLite + keyword retrieval, без vector DB.
// Embeddings и semantic search готовятся архитектурно (см. Sprint 38 P2),
// но не реализованы.
//
// Изоляция:
//   • global KB видна всем; chunks ОБЯЗАНЫ быть redacted на ingest.
//   • project KB видна только в контексте этого projectId.
//   • visibility=internal — только manager/admin/super_admin
//   • visibility=client_safe — founder тоже может видеть source title
//   • text snippet самого chunk'а founder НЕ видит никогда (только title)
//
// scope = 'global' | 'project'
// sourceType = см. Sprint 38 P1 taxonomy: successful_sale | failed_sale |
//              objection | qualification | follow_up | legal_question |
//              financial_question | project_presentation | deal_case |
//              manager_script | messenger_thread | meeting_recording | other
// status = 'draft' | 'published' | 'disabled'
// visibility = 'internal' | 'client_safe'
model KnowledgeSource {
  id                     String   @id @default(cuid())
  scope                  String   // 'global' | 'project'
  projectId              String?
  project                Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title                  String
  sourceType             String   // taxonomy enum (см. комментарий выше)
  status                 String   @default("draft") // draft / published / disabled
  visibility             String   @default("internal") // internal / client_safe

  // Source backlinks — какой именно UploadedFile / Analysis / Session породил
  // эту запись. Удобно для preview в админке и для аудита «откуда».
  uploadedFileId         String?
  conversationAnalysisId String?
  salesSessionId         String?

  tagsJson               String?  // JSON array<string>: ['hot_lead', 'real_estate', …]
  summary                String?  // короткое safe-summary для founder UI

  // Sprint 40 — Candidate / quality control flow.
  //
  // База знаний не должна превращаться в склад мусора. Auto-capture'ы (из
  // ConversationAnalysis / SalesSession) попадают сюда как isCandidate=true
  // с status='draft' и qualityScore от 0 до 100. Manager или admin вручную
  // подтверждает (publish) или отклоняет (disable + reason).
  //
  //   • isCandidate=true  → авто-созданный, ждёт ручной проверки, НЕ участвует
  //                          в retrieval даже при status='published'.
  //   • isCandidate=false → проверенный человеком, может попасть в retrieval
  //                          если status='published'.
  isCandidate            Boolean  @default(false)
  qualityScore           Int?     // 0..100, эвристическая оценка ценности (см. captureCandidate*)
  qualityReasonJson      String?  // JSON array<string>: ['probabilityScore=78', 'has_objections', …]

  // Sprint 40 — дедупликация. На ingest вычисляем sha256 от нормализованного
  // текста. Если source с таким же contentHash уже существует (не архивированный) —
  // не создаём дубль, возвращаем existing. Защищает KB от повторной загрузки
  // того же файла, повторного capture той же встречи.
  contentHash            String?

  // Sprint 40 — provenance. Откуда source появился: 'manual_note' / 'file_upload' /
  // 'auto_capture_analysis' / 'auto_capture_session' / 'import_from_analysis' /
  // 'import_from_file'. originId — внешний reference, например conversationAnalysisId.
  originType             String?
  originId               String?

  // Sprint 40 — verification. Заполняется когда manager/admin нажимает
  // «Подтвердить и опубликовать» (или просто публикует draft вручную).
  verifiedById           String?
  verifiedAt             DateTime?
  publishedAt            DateTime?
  disabledReason         String?  // причина отключения (показывается в админке)

  // Sprint 40 — retrieval-метрики. Каждый retrieval, который попадает в AI prompt,
  // инкрементирует retrievalCount и обновляет lastRetrievedAt. Используется
  // для UI «какие источники AI чаще всего использует» и для бонуса в scoring
  // (свежие активно используемые источники чуть выше).
  lastRetrievedAt        DateTime?
  retrievalCount         Int      @default(0)

  // Sprint 40 P1 — environment. Разделение production / demo / synthetic данных.
  // production — реальные клиентские кейсы, не для demo workspace.
  // demo       — глобальные кейсы Главснаб/Luce Silva, для demo workspace.
  // synthetic  — публичные обезличенные примеры, безопасны для всех.
  environment            String   @default("production") // production / demo / synthetic

  createdById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  archivedAt             DateTime?

  chunks                 KnowledgeChunk[]

  @@index([scope, status])
  @@index([projectId, status])
  @@index([sourceType, status])
  @@index([createdAt])
  // Sprint 40 — индексы для candidate-flow и dedupe lookup'а.
  @@index([isCandidate, status])
  @@index([contentHash])
  @@index([environment, status])
}

// Chunked текст source'а. Размер ~800-1200 символов на chunk (см.
// knowledgeService.chunkText). На retrieve мы скорим chunks по keywords
// из transcript'а, забираем top-N. tagsJson наследуется от source, можно
// и переопределить per-chunk (для future таггирования).
model KnowledgeChunk {
  id            String   @id @default(cuid())
  sourceId      String
  source        KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  // projectId копируется из source для быстрых индексов и WHERE-фильтров.
  // Чтобы запрос «retrieve для project X» работал одним index hit'ом, без
  // JOIN'а на KnowledgeSource.
  projectId     String?

  chunkIndex    Int       // 0-based
  text          String    // сырой текст для manager/admin
  redactedText  String?   // phones/urls/emails замаскированы — для founder UI
  tokenEstimate Int       // примерно text.length / 4 — на момент ingest

  tagsJson      String?
  createdAt     DateTime  @default(now())

  @@index([sourceId, chunkIndex])
  @@index([projectId])
}

// Sprint 42 — структурированный лог retrieval-событий.
//
// В Sprint 40 каждый retrieval писал AuditEvent (action='knowledge.retrieval').
// Это было удобно для расследования инцидентов, но плохо подходит для метрик:
// нужно парсить JSON payload, нет индекса по projectId / feature, не связать
// с конкретной sales session.
//
// KnowledgeRetrievalEvent — отдельная таблица для measurable outcomes. Audit
// event остаётся для security forensics, эта — для analytics. Sprint 43+ можно
// добавить outcome-поля (acceptedByUser, leadToConversion и т.д.) без миграции
// существующего audit-кода.
//
// SECURITY: НИКОГДА не пишем transcript, prompt, raw chunk text, raw query.
// Только metadata: какие sources/chunks были выбраны, сколько символов в
// контексте, какая фича запросила.
model KnowledgeRetrievalEvent {
  id              String   @id @default(cuid())

  // Кто запросил retrieval. actorId nullable — на случай system-инициированных
  // retrieval'ов (например, future autoscoring пайплайны).
  actorId         String?

  // Какой проект (если есть). Без FK constraint — retrieval может быть для
  // удалённого/архивированного проекта, и event должен пережить.
  projectId       String?

  // Какая фича вызвала retrieval. См. RetrievalOptions.feature.
  feature         String

  // Какие sources / chunks были выбраны (JSON array of cuid). Не FK — для
  // того же reason'а (удалённые sources не должны ломать historic events).
  sourceIdsJson   String
  chunkIdsJson    String?

  // Метрика «сколько мы реально подмешали в prompt». Полезно для оценки
  // budget'а: если sources>0 но totalChars=0 — что-то фильтрнуло, диагностика.
  sourceCount     Int
  totalChars      Int

  // Sprint 42 — связь с реальной встречей / анализом (если retrieval привязан).
  // Permission'ы передаются в route — здесь это просто backlinks для дашборда
  // «AI помог в этой сессии».
  conversationAnalysisId String?
  salesSessionId         String?

  createdAt       DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([feature, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// Sprint 43 — AssistantAdviceEvent: что именно AI посоветовал в один из моментов
// встречи. Sprint 42 KnowledgeRetrievalEvent ловит «какой KB использовался»,
// этот — что AI на основе KB+transcript ответил. Связка retrievalEventId →
// adviceEventId → (потом) salesSessionId → outcomeEvent — это и есть learning
// loop.
//
// Сохраняется ТОЛЬКО на full analyze (/api/sales-assistant/analyze). На fast
// analyze не пишем — fast вызывается часто на короткой встрече, и шум загрязнит
// аналитику. Если в Sprint 44+ понадобится — добавим поле phase='fast' и
// фильтр в UI.
//
// SECURITY: НИКОГДА не хранить:
//   • полный transcript встречи (он в SalesSession.transcript)
//   • полный prompt (он реконструируется из template + context)
//   • raw chunk snippets (они в KnowledgeChunk.text)
// Только metadata — что AI сказал коротко (mainQuestion / nextStep — это уже
// готовые user-facing фразы, не secret data) + provider/model для воспроизводимости.
model AssistantAdviceEvent {
  id                     String   @id @default(cuid())

  projectId              String?
  actorId                String?
  salesSessionId         String?
  conversationAnalysisId String?

  // FK на retrieval event этого AI-вызова. NULL если KB не дала результата
  // (retrieve вернул 0 sources) — но мы всё равно пишем advice event, важно
  // знать, что AI отвечал без KB-контекста.
  retrievalEventId       String?

  // Sprint 43 — пока всегда 'full'. Поле зарезервировано на Sprint 44 для
  // расширения (например 'meeting_summary', 'follow_up_draft').
  phase                  String   @default("full")

  // Слой структуры AI-ответа, который мы считаем безопасным сохранить.
  // Это уже user-facing фразы — никакой raw transcript-leak'и.
  spinStage              String?  // S | P | I | N
  tone                   String?  // SOFT | CONTROL | CLOSE
  mainQuestion           String?  // главный вопрос, который AI предложил спросить
  nextStep               String?  // dealNextStep
  recommendation         String?  // первый whatToDo
  confidence             Int?     // 0..100

  // Какие KB-источники / chunks реально попали в prompt. Cuid'ы, JSON-массивы.
  // НЕ snippet text — только ids.
  usedSourceIdsJson      String
  usedChunkIdsJson       String?

  provider               String?  // openai | anthropic | mock
  model                  String?  // имя модели на момент вызова
  fellBackToMock         Boolean  @default(false)

  promptSource           String?  // db | fallback
  promptTemplateId       String?  // id PromptTemplate.sales_gpt, если применимо

  createdAt              DateTime @default(now())

  outcomes               AssistantOutcomeEvent[]

  @@index([projectId, createdAt])
  @@index([actorId, createdAt])
  @@index([salesSessionId, createdAt])
  @@index([conversationAnalysisId, createdAt])
  @@index([retrievalEventId])
}

// Sprint 43 — AssistantOutcomeEvent: что произошло после AI-подсказки. Manager
// или фаундер фиксирует результат: «отправил follow-up», «инвестор согласился»,
// «потеряли». Это сигнал, замыкающий learning loop без авто-инференса (его не
// делаем — слишком легко перетренировать на шуме).
//
// FK на AssistantAdviceEvent опциональный — outcome можно зафиксировать и без
// конкретного advice (например, по всей встрече). projectId / salesSessionId /
// conversationAnalysisId независимы — fill один или несколько, мы их используем
// для аналитики per-source и per-project.
//
// SECURITY:
//   • note ограничен по длине (см. zod schema в route).
//   • audit пишет только outcomeType + metadata, не сам note.
//   • Founder видит только outcomes своих проектов (см. route ownership).
model AssistantOutcomeEvent {
  id                     String   @id @default(cuid())

  // Можно привязать к конкретной подсказке. NULL если outcome охватывает
  // всю встречу или вообще без AI-помощи.
  adviceEventId          String?
  adviceEvent            AssistantAdviceEvent? @relation(fields: [adviceEventId], references: [id], onDelete: SetNull)

  projectId              String?
  salesSessionId         String?
  conversationAnalysisId String?

  // Имя инвестора, как видит его пользователь. Не FK — leads могут быть
  // вне системы, ad-hoc.
  investorName           String?

  // Whitelist из спеки. zod validation в route.
  // follow_up_sent | next_meeting_booked | investor_requested_docs |
  // investor_interested | investment_received | lost | ghosted |
  // no_decision | bad_fit
  outcomeType            String

  valueRub               Float?
  probabilityAfter       Int?     // 0..100

  // Свободный комментарий менеджера. Ограничен по длине в zod (см. route).
  note                   String?

  createdById            String?
  createdAt              DateTime @default(now())
  archivedAt             DateTime?

  @@index([adviceEventId, createdAt])
  @@index([projectId, createdAt])
  @@index([salesSessionId, createdAt])
  @@index([conversationAnalysisId, createdAt])
  @@index([outcomeType, createdAt])
  @@index([createdById, createdAt])
  @@index([archivedAt])
}
